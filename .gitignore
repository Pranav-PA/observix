.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Local configuration that should never be committed
observix.local.toml
.env

# Backend state written by the live tests
.mlflow/
mlflow.db
mlruns/
phoenix.log
mlflow.log
.phoenix/
